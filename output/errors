result3 = 10 / 0


# Variable 'local_variable' is defined in scope 'first_function' but is out of scope here
def first_function():
    local_variable = 100

first_function()

print(local_variable)


# Function 'inner_function' is defined in scope 'outer_function' but is out of scope here
def outer_function():
    def inner_function():
        return 10

outer_function()

inner_function()




