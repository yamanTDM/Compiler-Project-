<!DOCTYPE html>
<html>
<head>
    <!-- Undefined template variable -->
    <title>{{ undefined_variable }}</title>
</head>

<body>

<!-- Variable defined in another scope -->
<p>{{ out_of_scope_variable }}</p>


<!-- Undefined variable in an if condition -->
{% if missing_condition %}
<p>Condition</p>
{% endif %}


<!-- Undefined variable in a comparison -->
{% if missing_age > 18 %}
<p>Adult</p>
{% endif %}


<!-- Undefined variable in a for collection -->
{% for user in missing_users %}
<p>{{ user }}</p>
{% endfor %}


<!-- Undefined variable inside a loop condition -->
{% for user in users if missing_filter %}
<p>{{ user }}</p>
{% endfor %}


<!-- Loop variable shadows collection -->
{% for users in users %}
<p>{{ users }}</p>
{% endfor %}


<!-- Undefined Jinja function -->
{{ unknown_function() }}


<!-- url_for() without endpoint -->
{{ url_for() }}


<!-- Assigning to a reserved Jinja name -->
{% set true = "hello" %}


<!-- super() outside inherited template block -->
{{ super() }}


<!-- Duplicate Jinja block name -->
{% block content %}
<p>First content</p>
{% endblock %}

{% block content %}
<p>Second content</p>
{% endblock %}


<!-- Undefined variable in a Jinja function argument -->
{{ url_for("profile", user_id=missing_user_id) }}

</body>
</html>