# Variable 'undefined_variable' is used but never defined.
print(undefined_variable)


# Function 'unknown_function' is used but never defined.
unknown_function()


# 'number' is not a function but is being called.
number = 10
number()


# Function 'add' called with 1 argument(s) but requires 2.
def add(a, b):
    return a + b

add(10)

# Function 'multiply' called with 3 argumentS but only accepts 2.
def multiply(a, b):
    return a * b

multiply(2, 3, 4)

# 'return' used outside of a function.
return 10


